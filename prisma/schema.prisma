// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         String @default("DEPT_OFFICER") // ENUM: SUPER_ADMIN, ASSET_CONTROLLER, DEPT_OFFICER, AUDITOR

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  assignedAssets     Asset[]         @relation("AssignedUser")
  recordedLocations  AssetLocation[] @relation("RecordedBy")
  requestedMovements AssetMovement[] @relation("RequestedBy")
  approvedMovements  AssetMovement[] @relation("ApprovedBy")
  auditLogs          AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  users         User[]
  assets        Asset[]         @relation("CurrentDepartment")
  movementsFrom AssetMovement[] @relation("FromDepartment")
  movementsTo   AssetMovement[] @relation("ToDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String
  status      String  @default("ACTIVE") // ENUM: ACTIVE, INACTIVE, DISPOSED, MISSING, MAINTENANCE
  condition   String  @default("GOOD") // ENUM: EXCELLENT, GOOD, FAIR, POOR, SCRAP

  qrCodeHash String  @unique
  imageUrl   String?

  purchaseDate  DateTime
  purchasePrice Float

  currentDepartmentId String?
  currentDepartment   Department? @relation("CurrentDepartment", fields: [currentDepartmentId], references: [id])

  assignedUserId String?
  assignedUser   User?   @relation("AssignedUser", fields: [assignedUserId], references: [id])

  valuation Valuation?
  locations AssetLocation[]
  movements AssetMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Valuation {
  id      String @id @default(cuid())
  assetId String @unique
  asset   Asset  @relation(fields: [assetId], references: [id])

  method String @default("STRAIGHT_LINE") // ENUM: STRAIGHT_LINE, REDUCING_BALANCE
  rate   Float // Percentage for reducing balance, or lifespan years for straight line

  accumulatedDepreciation Float @default(0)
  currentBookValue        Float

  lastCalculatedAt DateTime @default(now())
}

model AssetLocation {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  latitude  Float?
  longitude Float?
  address   String?

  recordedById String
  recordedBy   User   @relation("RecordedBy", fields: [recordedById], references: [id])

  recordedAt DateTime @default(now())
}

model AssetMovement {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  fromDepartmentId String?
  fromDepartment   Department? @relation("FromDepartment", fields: [fromDepartmentId], references: [id])

  toDepartmentId String
  toDepartment   Department @relation("ToDepartment", fields: [toDepartmentId], references: [id])

  requestedById String
  requestedBy   User   @relation("RequestedBy", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  status String  @default("PENDING") // ENUM: PENDING, APPROVED, REJECTED, COMPLETED
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String @id @default(cuid())
  action     String // e.g., "ASSET_CREATED", "QR_SCANNED", "VALUATION_RECALCULATED"
  entityType String // e.g., "ASSET", "USER"
  entityId   String // The ID of the affected entity

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  details   String // JSON stringified details of the change/event
  ipAddress String? // For access auditing

  timestamp DateTime @default(now())
}
